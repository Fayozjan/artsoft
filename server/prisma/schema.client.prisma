  uploaded_by users @relation(fields: [uploaded_by_id], references: [id])

  @@index([task_id])
}

model attendance_filter_presets {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  filter     Json
  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  addedBy users @relation("AttendanceFilterPresetCreatedBy", fields: [created_by], references: [id])

  @@index([created_by])
}

model timesheet_filter_presets {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  filter     Json
  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  addedBy users @relation("TimesheetFilterPresetCreatedBy", fields: [created_by], references: [id])

  @@index([created_by])
}

model late_employees_filter_presets {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  filter     Json
  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  addedBy users @relation("LateEmployeesFilterPresetCreatedBy", fields: [created_by], references: [id])

  @@index([created_by])
}

model cron_tasks {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(255)
  task_type String @default("attendance_report") @db.VarChar(50)
  config    Json

  // schedule_kind = "daily"    → hour + minute + days_of_week
  // schedule_kind = "interval" → interval_minutes (каждые N минут от last_run_at)
  schedule_kind    String @default("daily") @db.VarChar(20)
  hour             Int?
  minute           Int?
  days_of_week     Int[]
  interval_minutes Int?

  status          Boolean   @default(true)
  last_run_at     DateTime? @db.Timestamptz(6)
  last_run_status String?   @db.VarChar(20)
  last_run_error  String?
  created_by      Int
  added_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  addedBy users @relation("CronTaskCreatedBy", fields: [created_by], references: [id])

  @@index([status])
  @@index([created_by])
}

// ─── Столовая ────────────────────────────────────────────────────────────────

// Дневная норма порций сотрудника. Одна строка на сотрудника: норма
// не накапливается — каждый день остаток считается заново как
// daily_limit − выданные сегодня порции.
model canteen_allowances {
  id          Int      @id @default(autoincrement())
  employee_id Int      @unique
  daily_limit Int      @default(1)
  status      Boolean  @default(true)
  note        String?  @db.VarChar(255)
  added_by    Int?
  added_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  employee employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  addedBy  users?    @relation("CanteenAllowanceCreatedBy", fields: [added_by], references: [id])

  @@index([status])
}

// Одна строка = одно распознавание на терминале столовой.
// Отказы (нормы нет / норма исчерпана) тоже пишем — нужны в отчёте.
model canteen_meals {
  id             Int      @id @default(autoincrement())
  employee_id    Int
  face_device_id Int?
  date           DateTime @db.Timestamptz(6)
  // Локальная (Asia/Tashkent) дата события. Дневной остаток считается по ней:
  // по UTC ужин после 19:00 попадал бы уже в следующие сутки.
  meal_date      DateTime @db.Date
  // employeeNo-serialNo устройства — защита от повторной обработки события
  identifier     String?  @db.VarChar(50)
  // served — порция выдана | denied — отказ
  status         String   @default("served") @db.VarChar(20)
  // no_allowance — нормы нет либо выключена | limit_reached — норма исчерпана
  deny_reason    String?  @db.VarChar(30)
  // норма на момент события — отчёт не должен меняться задним числом
  daily_limit    Int      @default(0)
  photo          String?  @db.VarChar(255)
  added_at       DateTime @default(now()) @db.Timestamptz(6)

  employee   employees     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  faceDevice face_devices? @relation(fields: [face_device_id], references: [id], onDelete: SetNull)

  @@unique([face_device_id, identifier])
  @@index([employee_id, meal_date])
  @@index([meal_date, status])
}

// ─── Швейное производство ──────────────────────────────────────────────────

// Приход партии сырья (пряжа/полотно). Пока только журнал документов —
// без движения складских остатков.
model batch_receipts {
  id               Int      @id @default(autoincrement())
  document_number  String   @unique @db.VarChar(50)
  batch_number     String   @unique @db.VarChar(100)
  receipt_date     DateTime @db.Date
  order_number     String?  @db.VarChar(100)
  customer         String?  @db.VarChar(255)
  status           String   @default("draft") @db.VarChar(20) // draft | accepted
  comment          String?
  added_by         Int
  added_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  addedBy users                 @relation(fields: [added_by], references: [id])
  items   batch_receipt_items[]

  @@index([status])
  @@index([receipt_date])
}

model batch_receipt_items {
  id              Int      @id @default(autoincrement())
  receipt_id      Int
  product_name    String?  @db.VarChar(255)
  color           String?  @db.VarChar(100)
  color_variant   String?  @db.VarChar(100)
  color_tone      String?  @db.VarChar(100)
  size            String?  @db.VarChar(50)
  yarn_type       String?  @db.VarChar(100)
  material        String?  @db.VarChar(100)
  design          String?  @db.VarChar(100)
  quantity        Decimal  @db.Decimal(15, 4)
  gross_weight_kg Decimal? @db.Decimal(15, 4)
  roll_count      Int?
  grammage        Decimal? @db.Decimal(10, 2)
  sort_order      Int      @default(0)
  // Позицию может добавить другой пользователь (дописать в принятую партию).
  // null — позиции, созданные до появления поля: считаем автором партии.
  added_by        Int?

  receipt      batch_receipts  @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  addedBy      users?          @relation(fields: [added_by], references: [id])
  workStickers work_stickers[]

  @@index([receipt_id])
}

// Справочник типов операций (раскрой, пошив, вышивка, утюжка, упаковка...)
model operation_types {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  unit       String?  @db.VarChar(20)
  price      Decimal? @db.Decimal(15, 2)
  complexity String?  @db.VarChar(20) // simple | medium | hard
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  // Последняя операция: при приёме работы следующая операция не печатается
  // (nextOperations у такого типа всегда пуст).
  is_final   Boolean  @default(false)
  // Операция исправления: выбирается только как "операция для исправления" и
  // никогда — как следующая операция; в списке исправления видны только такие типы.
  is_rework  Boolean  @default(false)
  // Первая операция после прихода партии: в распределении работы по позиции партии
  // выбирается автоматически. Такой тип один — при сохранении флаг снимается с
  // остальных; операция исправления первой быть не может.
  is_first   Boolean  @default(false)
  // Разрешает на «Приёме работы» объединять несколько принятых стикеров этой
  // операции (одной партии и размера) в один перед раздачей дальше — см.
  // work_stickers.merged_into_id.
  allow_merge Boolean @default(false)
  // Разрешает на «Приёме работы» указать «Не выполнено» — часть стикера, которую не
  // успели сделать: не оплачивается, при раздаче уходит на выбранную операцию для
  // не выполненных (см. operation_type_incomplete_operations).
  allow_incomplete Boolean @default(false)
  // Только у операции исправления (is_rework): какую операцию она исправляет, например
  // «Исправление пошива» → «Пошив». При раздаче исправления по этому типу сервер сам
  // находит виновный стикер среди предков (см. work_stickers.origin_sticker_id) —
  // приёмщик ничего, кроме самой операции исправления, не выбирает.
  rework_target_operation_type_id Int?

  // Кто добавил тип. null у типов, созданных до появления поля.
  added_by Int?

  addedBy users? @relation("OperationTypeAddedBy", fields: [added_by], references: [id])

  // Исправляемая операция — цель для операции исправления; SetNull — удаление
  // исправляемой операции не удаляет операцию исправления.
  reworkTarget operation_types?  @relation("OperationTypeReworkTarget", fields: [rework_target_operation_type_id], references: [id], onDelete: SetNull)
  reworkedBy   operation_types[] @relation("OperationTypeReworkTarget")

  // Следующие операции по умолчанию: один вариант — подставляется при приёме
  // работы сам, несколько — приёмщик выбирает из них (см. operation_type_next_operations).
  nextOperations operation_type_next_operations[] @relation("OperationTypeNextOptions")
  nextOptionOf   operation_type_next_operations[] @relation("OperationTypeNextOptionsTarget")

  // Операции для исправления по умолчанию: так же — один вариант подставляется
  // сам, несколько — приёмщик выбирает из них (см. operation_type_rework_operations).
  reworkOperations operation_type_rework_operations[] @relation("OperationTypeReworkOptions")
  reworkOptionOf   operation_type_rework_operations[] @relation("OperationTypeReworkOptionsTarget")

  // Операции для не выполненных по умолчанию (только при allow_incomplete): так же —
  // один вариант подставляется сам, несколько — приёмщик выбирает из них.
  incompleteOperations operation_type_incomplete_operations[] @relation("OperationTypeIncompleteOptions")
  incompleteOptionOf   operation_type_incomplete_operations[] @relation("OperationTypeIncompleteOptionsTarget")

  items       operation_items[]
  workStickers work_stickers[]
  employees    operation_type_employees[]
  teams        employee_teams[]

  @@index([rework_target_operation_type_id])
}

// Следующие операции по умолчанию для типа: несколько строк на один тип.
// Один вариант — при приёме работы подставляется сам, несколько — приёмщик
// выбирает из них (см. WorkStickerRoutePanel / operationTypes.service.js).
model operation_type_next_operations {
  operation_type_id      Int
  next_operation_type_id Int

  operationType     operation_types @relation("OperationTypeNextOptions", fields: [operation_type_id], references: [id], onDelete: Cascade)
  nextOperationType operation_types @relation("OperationTypeNextOptionsTarget", fields: [next_operation_type_id], references: [id], onDelete: Cascade)

  @@id([operation_type_id, next_operation_type_id])
  @@index([next_operation_type_id])
}

// Операции для исправления по умолчанию для типа: несколько строк на один тип,
// как operation_type_next_operations, но цель — только тип, помеченный is_rework.
model operation_type_rework_operations {
  operation_type_id        Int
  rework_operation_type_id Int

  operationType       operation_types @relation("OperationTypeReworkOptions", fields: [operation_type_id], references: [id], onDelete: Cascade)
  reworkOperationType operation_types @relation("OperationTypeReworkOptionsTarget", fields: [rework_operation_type_id], references: [id], onDelete: Cascade)

  @@id([operation_type_id, rework_operation_type_id])
  @@index([rework_operation_type_id])
}

// Операции для не выполненных по умолчанию для типа: несколько строк на один тип,
// как operation_type_rework_operations, но цель — обычный тип (не исправление).
model operation_type_incomplete_operations {
  operation_type_id            Int
  incomplete_operation_type_id Int

  operationType           operation_types @relation("OperationTypeIncompleteOptions", fields: [operation_type_id], references: [id], onDelete: Cascade)
  incompleteOperationType operation_types @relation("OperationTypeIncompleteOptionsTarget", fields: [incomplete_operation_type_id], references: [id], onDelete: Cascade)

  @@id([operation_type_id, incomplete_operation_type_id])
  @@index([incomplete_operation_type_id])
}

// Сотрудники, допущенные к типу операции: при приёме работы (скан стикера)
// в выборе показываются только они. Нет ни одной записи — допущены все.
model operation_type_employees {
  operation_type_id Int
  employee_id       Int

  operationType operation_types @relation(fields: [operation_type_id], references: [id], onDelete: Cascade)
  employee      employees       @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@id([operation_type_id, employee_id])
  @@index([employee_id])
}

// Команда сотрудников внутри типа операции: сохранённый набор из уже
// допущенных сотрудников (operation_type_employees). При приёме работы
// подставляется целиком одной кнопкой вместо выбора каждого по одному.
// Команд на один тип операции может быть сколько угодно.
model employee_teams {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(100)
  operation_type_id Int
  added_by          Int?
  added_at          DateTime @default(now()) @db.Timestamptz(6)

  operationType operation_types         @relation(fields: [operation_type_id], references: [id], onDelete: Cascade)
  addedBy       users?                  @relation("EmployeeTeamAddedBy", fields: [added_by], references: [id])
  members       employee_team_members[]

  @@unique([operation_type_id, name])
  @@index([operation_type_id])
}

model employee_team_members {
  team_id     Int
  employee_id Int

  team     employee_teams @relation(fields: [team_id], references: [id], onDelete: Cascade)
  employee employees      @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@id([team_id, employee_id])
  @@index([employee_id])
}

// Учёт выполненных операций по сотрудникам (сдельная работа). Пока не связан
// с batch_receipts и не влияет на payroll — отдельный журнал фактов.
model operations {
  id              Int      @id @default(autoincrement())
  document_number String   @unique @db.VarChar(50)
  operation_date  DateTime @db.Date
  order_number    String?  @db.VarChar(100)
  status          String   @default("draft") @db.VarChar(20) // draft | accepted
  comment         String?
  added_by        Int
  added_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  addedBy users             @relation(fields: [added_by], references: [id])
  items   operation_items[]

  @@index([status])
  @@index([operation_date])
}

model operation_items {
  id                Int     @id @default(autoincrement())
  operation_id      Int
  employee_id       Int
  operation_type_id Int
  quantity          Decimal @db.Decimal(15, 4)
  rate              Decimal @db.Decimal(15, 2)
  amount            Decimal @db.Decimal(15, 2)
  comment           String?
  sort_order        Int     @default(0)

  operation     operations      @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  employee      employees       @relation(fields: [employee_id], references: [id])
  operationType operation_types @relation(fields: [operation_type_id], references: [id])

  @@index([operation_id])
  @@index([employee_id])
  @@index([operation_type_id])
}

// Распределение работы и приём работы. Стикер = единица работы (пачка/бандл),
// печатается при раздаче партии на операцию — сотрудник и факт выполнения
// проставляются позже, при скане стикера ("Приём работы").
model work_stickers {
  id                    Int       @id @default(autoincrement())
  sticker_code          String    @unique @db.VarChar(50)
  batch_receipt_item_id Int
  operation_type_id     Int
  planned_quantity      Decimal   @db.Decimal(15, 4)
  rate                  Decimal?  @db.Decimal(15, 2) // снимок цены типа операции на момент печати
  status                String    @default("pending") @db.VarChar(20) // pending | done | scrapped
  employee_id           Int?
  actual_quantity       Decimal?  @db.Decimal(15, 4) // выполнено (годное) — оплачивается и раздаётся дальше
  defect_quantity       Decimal?  @db.Decimal(15, 4) // брак, указанный при приёме; не оплачивается, для него печатается стикер брака
  rework_quantity       Decimal?  @db.Decimal(15, 4) // на исправление, указано при приёме (сверх actual_quantity); при раздаче уходит на выбранную операцию исправления
  incomplete_quantity   Decimal?  @db.Decimal(15, 4) // не выполнено, указано при приёме (только если у типа allow_incomplete); не оплачивается, при раздаче уходит на выбранную операцию для не выполненных
  amount                Decimal?  @db.Decimal(15, 2)
  comment               String?
  added_by              Int
  added_at              DateTime  @default(now()) @db.Timestamptz(6)
  scanned_by            Int?
  scanned_at            DateTime? @db.Timestamptz(6)

  // При разделении после скана (advance) создаются child-стикеры с
  // parent_sticker_id — так трекается вся цепочка бандла без переиспользования
  // одного sticker_code.
  parent_sticker_id Int?
  split_kind        String? @db.VarChar(20) // normal | rework | incomplete | scrap — путь, которым этот кусок получен от родителя (scrap — стикер брака); share — доля сотрудника при приёме

  // Работу принятого стикера могли выполнить несколько сотрудников. Стикер хранит
  // долю первого (основного) сотрудника, а доля каждого следующего — отдельная
  // принятая строка с share_of_id на основной стикер (split_kind = share,
  // planned_quantity = 0). Так каждая доля — обычный принятый стикер со своим
  // сотрудником, количеством и суммой, и отчёты считают её без изменений.
  // Выполнено всего = actual_quantity основного + actual_quantity его долей.
  share_of_id Int?

  // Объединение принятых стикеров одной операции/партии/размера в один — перед
  // раздачей на следующую операцию (см. operation_types.allow_merge). В отличие
  // от parent_sticker_id (1 родитель → N детей при раздаче) тут наоборот: N
  // источников → 1 результат, поэтому связь хранится на стороне источника.
  // onDelete: SetNull — удаление результата не должно затронуть уже оплаченные
  // исходные стикеры, они просто снова считаются неразданными.
  merged_into_id Int?

  // Отмечен для объединения (кнопка на карточке приёма) — раздача этого стикера
  // одиночно заблокирована, пока флаг не снят. Режим объединения при входе сразу
  // подгружает все такие стикеры, доступные логину, — не нужно сканировать заново.
  awaiting_merge Boolean @default(false)

  // Операция-виновник: принятый стикер более ранней операции, работу которой этот
  // стикер (split_kind = rework) возвращает на исправление. parent_sticker_id — это
  // стикер, где брак нашли (например, «Контроль»), а виновная операция может быть на
  // несколько шагов раньше — при раздаче сервер находит её сам: ближайший принятый
  // предок с типом operation_types.rework_target_operation_type_id операции исправления.
  // null — не найдена или у операции исправления она не задана. onDelete: SetNull —
  // удаление виновного стикера не трогает стикер исправления. Виновника наследуют и
  // следующие за исправлением стикеры (например, «Ремонт» → «Утюжка после ремонта»):
  // цепочка возврата заканчивается на операции, где брак нашли.
  origin_sticker_id Int?

  batchReceiptItem batch_receipt_items    @relation(fields: [batch_receipt_item_id], references: [id], onDelete: Cascade)
  operationType    operation_types        @relation(fields: [operation_type_id], references: [id])
  employee         employees?             @relation(fields: [employee_id], references: [id])
  addedBy          users                  @relation("WorkStickerAddedBy", fields: [added_by], references: [id])
  scannedBy        users?                 @relation("WorkStickerScannedBy", fields: [scanned_by], references: [id])
  parent           work_stickers?         @relation("StickerLineage", fields: [parent_sticker_id], references: [id])
  children         work_stickers[]        @relation("StickerLineage")
  shareOf          work_stickers?         @relation("StickerShares", fields: [share_of_id], references: [id], onDelete: Cascade)
  shares           work_stickers[]        @relation("StickerShares")
  mergedInto       work_stickers?         @relation("StickerMerge", fields: [merged_into_id], references: [id], onDelete: SetNull)
  mergedSources     work_stickers[]        @relation("StickerMerge")
  origin           work_stickers?         @relation("StickerReworkOrigin", fields: [origin_sticker_id], references: [id], onDelete: SetNull)
  reworkReturns    work_stickers[]        @relation("StickerReworkOrigin")

  @@index([batch_receipt_item_id])
  @@index([status])
  @@index([parent_sticker_id])
  @@index([share_of_id])
  @@index([merged_into_id])
  @@index([awaiting_merge])
  @@index([origin_sticker_id])
}

// Внешний вид и размер стикера "Распределение работы" — несколько вариантов
// дизайна на компанию, редактируются через кнопку-шестерёнку в панели печати
// (WYSIWYG-конструктор: перетаскивание/ресайз блоков на канвасе). Печатается
// всегда вариант с is_active=true (ровно один); остальные — заготовки/копии.
// elements — массив блоков вида {id, type: "qr"|"text", field?, x, y, w, h,
// fontSize, bold, align} в мм-координатах, PDF-генератор рисует их 1:1.
model work_sticker_templates {
  id         Int      @id @default(autoincrement())
  name       String   @default("Основной") @db.VarChar(60)
  is_active  Boolean  @default(true)
  width_mm   Decimal  @default(58) @db.Decimal(6, 2)
  height_mm  Decimal  @default(40) @db.Decimal(6, 2)
  elements   Json
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// ── Складской учёт: товар ──────────────────────────────────────────

model units {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  short_name String?  @db.VarChar(20)
  status     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  products   products[]
  stockMoves stock_moves[]
}

model product_categories {
  id        Int     @id @default(autoincrement())
  parent_id Int?
  name      String  @db.VarChar(255)
  status    Boolean @default(true)

  parent   product_categories?  @relation("ProductCategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children product_categories[] @relation("ProductCategoryHierarchy")
  products products[]

  categoryAttributes category_attributes[]
}

model products {
  id          Int      @id @default(autoincrement())
  category_id Int?
  unit_id     Int
  name        String   @db.VarChar(255)
  sku         String?  @db.VarChar(100)
  barcode     String?  @unique @db.VarChar(100)
  description String?
  min_stock   Int?
  status      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  category product_categories? @relation(fields: [category_id], references: [id])
  unit     units               @relation(fields: [unit_id], references: [id])

  stockMoves  stock_moves[]
  stockQuants stock_quants[]
  stockLots   stock_lots[]

  productAttributes product_attributes[]

  @@index([category_id])
}

model attributes {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  status     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  values             attribute_values[]
  categoryAttributes category_attributes[]
  productAttributes  product_attributes[]
  moveValues         stock_move_attribute_values[]
  lotValues          stock_lot_attribute_values[]
}

model attribute_values {
  id           Int      @id @default(autoincrement())
  attribute_id Int
  value        String   @db.VarChar(255)
  status       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  attribute  attributes                    @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  moveValues stock_move_attribute_values[]
  lotValues  stock_lot_attribute_values[]

  @@unique([attribute_id, value])
  @@index([attribute_id])
}

model category_attributes {
  id           Int     @id @default(autoincrement())
  category_id  Int
  attribute_id Int
  required     Boolean @default(false)

  category  product_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)
  attribute attributes         @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([category_id, attribute_id])
  @@index([attribute_id])
}

// Какие характеристики вообще применимы к товару (без значения) — значение
// выбирается позже, отдельно на каждой строке документа (stock_move_attribute_values).
model product_attributes {
  id           Int @id @default(autoincrement())
  product_id   Int
  attribute_id Int

  product   products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  attribute attributes @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([product_id, attribute_id])
  @@index([attribute_id])
}

// Значение характеристики на конкретной строке документа (выбирается при
// создании документа из значений, уже заведённых в attribute_values), из
// набора характеристик, разрешённых для товара в product_attributes.
model stock_move_attribute_values {
  id                 Int @id @default(autoincrement())
  move_id            Int
  attribute_id       Int
  attribute_value_id Int

  move           stock_moves      @relation(fields: [move_id], references: [id], onDelete: Cascade)
  attribute      attributes       @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  attributeValue attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade)

  @@unique([move_id, attribute_id])
  @@index([attribute_value_id])
}

// Партия остатка — связка (товар, цена, описание, набор характеристик).
// Расход/перемещение со склада выбирает конкретную партию (stock_moves.lot_id
// задаётся сразу в черновике), приход находит-или-создаёт партию по этой
// связке при проведении (см. resolveOrCreateLot в stockPickings.model.js).
// Пустые/одинаковые price_unit+note+атрибуты — одна и та же партия, остаток
// не дробится.
model stock_lots {
  id         Int      @id @default(autoincrement())
  product_id Int
  price_unit Decimal? @db.Decimal(15, 4)
  note       String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  product         products                     @relation(fields: [product_id], references: [id])
  moves           stock_moves[]
  quants          stock_quants[]
  attributeValues stock_lot_attribute_values[]

  @@index([product_id])
}

model stock_lot_attribute_values {
  id                 Int @id @default(autoincrement())
  lot_id             Int
  attribute_id       Int
  attribute_value_id Int

  lot            stock_lots       @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  attribute      attributes       @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  attributeValue attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade)

  @@unique([lot_id, attribute_id])
  @@index([attribute_value_id])
}

// ── Складской учёт: партнёры ───────────────────────────────────────

model partner_categories {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  status     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  partners partners[]
}

model partners {
  id                   Int      @id @default(autoincrement())
  category_id          Int?
  type                 String   @db.VarChar(20)
  name                 String   @db.VarChar(255)
  code                 String?  @db.VarChar(100)
  tax_number           String?  @unique @db.VarChar(100)
  contact_person       String?  @db.VarChar(255)
  phone                String?  @db.VarChar(50)
  email                String?  @db.VarChar(255)
  address              String?  @db.VarChar(500)
  note                 String?
  supplier_location_id Int?
  customer_location_id Int?
  status               Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  category         partner_categories? @relation(fields: [category_id], references: [id])
  supplierLocation stock_locations?    @relation("PartnerSupplierLocation", fields: [supplier_location_id], references: [id])
  customerLocation stock_locations?    @relation("PartnerCustomerLocation", fields: [customer_location_id], references: [id])

  pickingsAsSrc  stock_pickings[] @relation("PickingSrcPartner")
  pickingsAsDest stock_pickings[] @relation("PickingDestPartner")

  @@index([category_id])
}

// ── Складской учёт: локации ────────────────────────────────────────

model stock_locations {
  id            Int      @id @default(autoincrement())
  parent_id     Int?
  name          String   @db.VarChar(255)
  complete_name String?  @db.VarChar(1000)
  type          String   @db.VarChar(20)
  branch_id     Int?
  code          String?  @db.VarChar(50)
  note          String?
  is_scrap      Boolean  @default(false)
  status        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  parent   stock_locations?  @relation("StockLocationHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children stock_locations[] @relation("StockLocationHierarchy")
  branch   branches?         @relation(fields: [branch_id], references: [id])

  suppliersOf partners[] @relation("PartnerSupplierLocation")
  customersOf partners[] @relation("PartnerCustomerLocation")

  pickingTypeDefaultSrcOf  stock_picking_types[] @relation("PickingTypeDefaultSrc")
  pickingTypeDefaultDestOf stock_picking_types[] @relation("PickingTypeDefaultDest")
  pickingsAsSrc            stock_pickings[]      @relation("PickingLocationSrc")
  pickingsAsDest           stock_pickings[]      @relation("PickingLocationDest")
  movesAsSrc               stock_moves[]         @relation("MoveLocationSrc")
  movesAsDest              stock_moves[]         @relation("MoveLocationDest")
  quants                   stock_quants[]        @relation("QuantLocation")

  @@index([parent_id])
}

// ── Складской учёт: валюты ──────────────────────────────────────────
//
// code — ISO alpha (USD/EUR/RUB/UZS/...), он же Ccy в ответе ЦБ РУз
// (cbu.uz) — по нему подтягивается рекомендованный курс. Ровно одна
// строка is_base=true — базовая валюта отчётности (сум), для неё
// rate документа всегда 1 (см. CurrenciesService.getRecommendedRate).
model currencies {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(10)
  name       String   @db.VarChar(100)
  symbol     String?  @db.VarChar(10)
  is_base    Boolean  @default(false)
  status     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  pickings stock_pickings[]
}

// ── Складской учёт: типы документов и сами документы ───────────────
//
// Тип документа (stock_picking_types) задаёт логику движения: code
// incoming/outgoing/internal определяет какая сторона (src/dest) виртуальная
// (поставщик/клиент/цех/расходы), а какая — физический склад. default_location_*
// — необязательная "прошивка" одной из сторон (например у "Приём от поставщика"
// src всегда "Поставщики"), вторую сторону (физический склад) выбирают при
// создании документа. Сам документ (stock_pickings) — шапка + строки (stock_moves),
// проводится (validate) — тогда остатки (stock_quants) пересчитываются; проведённый
// можно отменить (reverse — назад в черновик) или отменить совсем (cancel).
model stock_picking_types {
  id                        Int      @id @default(autoincrement())
  name                      String   @db.VarChar(255)
  code                      String   @db.VarChar(20) // incoming | outgoing | internal
  sequence_prefix           String   @db.VarChar(20)
  default_location_src_id   Int?
  default_location_dest_id  Int?
  status                    Boolean  @default(true)
  created_at                DateTime @default(now()) @db.Timestamptz(6)

  defaultLocationSrc  stock_locations? @relation("PickingTypeDefaultSrc", fields: [default_location_src_id], references: [id])
  defaultLocationDest stock_locations? @relation("PickingTypeDefaultDest", fields: [default_location_dest_id], references: [id])
  pickings            stock_pickings[]
}

model stock_pickings {
  id                Int       @id @default(autoincrement())
  name              String    @unique @db.VarChar(50)
  type_id           Int
  src_partner_id    Int?
  dest_partner_id   Int?
  location_src_id   Int
  location_dest_id  Int
  origin            String?   @db.VarChar(255)
  state             String    @default("draft") @db.VarChar(20) // draft | confirmed | done | cancelled
  scheduled_date    DateTime? @db.Timestamptz(6)
  date_done         DateTime? @db.Timestamptz(6)
  note              String?
  payment_method    String?   @db.VarChar(20) // cash | card | transfer
  manager_id        Int? // менеджер по закупкам (incoming) / менеджер отдела продаж (outgoing)
  transport         String?   @db.VarChar(100) // марка/тип транспорта
  driver            String?   @db.VarChar(100) // ФИО водителя
  vehicle_number    String?   @db.VarChar(20) // гос. номер транспорта
  currency_id       Int
  rate              Decimal   @default(1) @db.Decimal(15, 6) // 1 ед. валюты документа = rate ед. базовой; снимок на момент документа
  added_by          Int?
  confirmed_by      Int? // кто подтвердил документ (draft -> confirmed)
  confirmed_at      DateTime? @db.Timestamptz(6)
  done_by           Int? // кто провёл документ (-> done), вместе с date_done
  edited_by         Int? // кто последним редактировал черновик (update)
  edited_at         DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  type         stock_picking_types @relation(fields: [type_id], references: [id])
  srcPartner   partners?           @relation("PickingSrcPartner", fields: [src_partner_id], references: [id])
  destPartner  partners?           @relation("PickingDestPartner", fields: [dest_partner_id], references: [id])
  locationSrc  stock_locations     @relation("PickingLocationSrc", fields: [location_src_id], references: [id])
  locationDest stock_locations     @relation("PickingLocationDest", fields: [location_dest_id], references: [id])
  currency     currencies          @relation(fields: [currency_id], references: [id])
  manager      employees?          @relation("PickingManager", fields: [manager_id], references: [id])
  addedBy      users?              @relation("PickingAddedBy", fields: [added_by], references: [id])
  confirmedBy  users?              @relation("PickingConfirmedBy", fields: [confirmed_by], references: [id])
  doneBy       users?              @relation("PickingDoneBy", fields: [done_by], references: [id])
  editedBy     users?              @relation("PickingEditedBy", fields: [edited_by], references: [id])
  moves        stock_moves[]

  @@index([type_id])
  @@index([state])
}

model stock_moves {
  id                Int      @id @default(autoincrement())
  picking_id        Int
  product_id        Int
  lot_id            Int?
  unit_id           Int?
  qty_demand        Decimal  @db.Decimal(15, 4)
  qty_done          Decimal  @default(0) @db.Decimal(15, 4)
  qty_packages      Decimal? @db.Decimal(15, 4)
  location_src_id   Int
  location_dest_id  Int
  state             String   @default("draft") @db.VarChar(20) // draft | done | cancelled
  price_unit        Decimal? @db.Decimal(15, 4)
  note              String?  @db.VarChar(500)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  picking      stock_pickings  @relation(fields: [picking_id], references: [id], onDelete: Cascade)
  product      products        @relation(fields: [product_id], references: [id])
  lot          stock_lots?     @relation(fields: [lot_id], references: [id])
  unit         units?          @relation(fields: [unit_id], references: [id])
  locationSrc  stock_locations @relation("MoveLocationSrc", fields: [location_src_id], references: [id])
  locationDest stock_locations @relation("MoveLocationDest", fields: [location_dest_id], references: [id])

  attributeValues stock_move_attribute_values[]

  @@index([product_id])
  @@index([picking_id])
  @@index([lot_id])
}

// Текущие остатки — materialized-кэш, обновляется только сервером при
// validate/cancel/reverse (см. stockPickings.service.js). Считает только по
// физическим (type=internal) локациям — виртуальные (поставщики/клиенты/…)
// источники/приёмники бесконечны и в остатках не участвуют.
// lot_id nullable на уровне колонки сознательно (старые строки до бэкофилла
// партий, см. server/scripts/migrate-stock-lots.js), но приложение всегда
// пишет его через applyQuantDelta(..., lotId, ...) — там lotId обязательный
// параметр, пустых значений после бэкофилла в проде быть не должно.
model stock_quants {
  id           Int      @id @default(autoincrement())
  product_id   Int
  location_id  Int
  lot_id       Int?
  qty          Decimal  @default(0) @db.Decimal(15, 4)
  qty_packages Decimal  @default(0) @db.Decimal(15, 4)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product  products        @relation(fields: [product_id], references: [id])
  location stock_locations @relation("QuantLocation", fields: [location_id], references: [id])
  lot      stock_lots?     @relation(fields: [lot_id], references: [id])

  @@unique([product_id, location_id, lot_id])
  @@index([location_id])
  @@index([lot_id])
}
