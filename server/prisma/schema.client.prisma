datasource db {
  provider = "postgresql"
  url      = env("CLIENT_DATABASE_URL") // динамически подставляем schema клиента
}

generator client {
  provider = "prisma-client-js"
  output   = "../prisma-clients/client" // отдельный клиент
}

model branches {
  id           Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(255)
  status       Boolean @default(true)
  director_id  Int?
  region       String? @db.VarChar(255)
  address      String? @db.VarChar(500)
  bank_name    String? @db.VarChar(255)
  bank_account String? @db.VarChar(255)
  inn          String? @db.VarChar(50)
  mfo          String? @db.VarChar(10)
  sort_order   Int     @default(0)

  added_at DateTime @default(now()) @db.Timestamptz(6)
  added_by Int

  director         employees?          @relation("BranchDirector", fields: [director_id], references: [id])
  employmentOrders employment_orders[]
  employees        employees[]
  gates            gates[]
  vehiclePasses    vehicle_passes[]
  departments      departments[]
  doors            doors[]
  addedBy          users               @relation(fields: [added_by], references: [id])
  stockLocations   stock_locations[]
}

model departments {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  status    Boolean  @default(true)
  branch_id Int
  added_at  DateTime @default(now()) @db.Timestamptz(6)

  employmentOrders  employment_orders[]
  employees         employees[]
  branch            branches            @relation(fields: [branch_id], references: [id])
  staffingPositions staffing_position[]
  tasksAssigned     tasks[]             @relation("TaskAssigneeDepartment")
}

model employment_orders {
  id            Int       @id @default(autoincrement())
  employee_id   Int?
  type          String?   @db.VarChar(50)
  date          DateTime? @db.Date
  branch_id     Int?
  department_id Int?
  position_id   Int?
  order_number  String?   @db.VarChar(100)
  note          String?
  added_at      DateTime  @default(now()) @db.Timestamptz(6)

  branch     branches?    @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position   positions?   @relation(fields: [position_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee   employees?   @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model employees {
  id                   Int       @id @default(autoincrement())
  employee_number      String?   @unique
  last_name            String?
  first_name           String?
  middle_name          String?   @db.VarChar(255)
  date_of_birth        DateTime? @db.Date
  gender               String?   @db.VarChar(255)
  passport             String?   @db.VarChar(255)
  passport_expiry_date DateTime? @db.Date
  pinfl                String?   @unique @db.VarChar(255)
  education            String?   @db.VarChar(255)
  phone                String?   @db.VarChar(255)
  email                String?   @db.VarChar(255)
  address              String?   @db.VarChar(255)
  status               Boolean?  @default(true)
  photo                String?   @db.VarChar(255)
  branch_id            Int?
  department_id        Int?
  position_id          Int?
  work_schedule_id     Int?
  education_specialty  String?   @db.VarChar(500)
  added_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  branch                  branches?                   @relation(fields: [branch_id], references: [id])
  department              departments?                @relation(fields: [department_id], references: [id])
  position                positions?                  @relation(fields: [position_id], references: [id])
  workSchedule            work_schedules?             @relation(fields: [work_schedule_id], references: [id])
  employeeScheduleHistory employee_schedule_history[]
  employeeSalaryHistory   employee_salary_history[]
  employmentOrders        employment_orders[]
  employeeTimeOffs        time_off[]                  @relation("employeeTimeOffs")
  facePasses              face_passes[]
  doors                   doors[]
  user                    users?
  directedBranches        branches[]                  @relation("BranchDirector")
  payrollSheetItems       payroll_sheet_items[]
  tasksAssigned           tasks[]                     @relation("TaskAssigneeEmployee")
  assetAssignments        asset_assignments[]
  debts                   employee_debts[]
  canteenAllowance        canteen_allowances?
  canteenMeals            canteen_meals[]
  operationItems          operation_items[]
  workStickers            work_stickers[]
  operationTypeLinks      operation_type_employees[]
  teamMemberships         employee_team_members[]
  pickingsAsManager       stock_pickings[]            @relation("PickingManager")

  @@index([branch_id])
  @@index([department_id])
}

model face_passes {
  id              Int      @id @default(autoincrement())
  date            DateTime @db.Timestamptz(6)
  identifier      String   @db.VarChar(50)
  photo           String?  @db.VarChar(255)
  employee_id     Int
  door_id         Int?
  face_devices_id Int?
  direction       String?  @db.VarChar(10)
  source          String?  @db.VarChar(20)
  latitude        Float?
  longitude       Float?
  added_at        DateTime @default(now()) @db.Timestamptz(6)

  employee   employees     @relation(fields: [employee_id], references: [id])
  faceDevice face_devices? @relation(fields: [face_devices_id], references: [id])
  door       doors?        @relation(fields: [door_id], references: [id])

  // identifier = employeeNo-serialNo, а serialNo — счётчик журнала конкретного
  // устройства. Два устройства независимо доходят до одного serialNo, поэтому
  // уникальность только в паре с face_devices_id.
  @@unique([face_devices_id, identifier])
  @@index([employee_id, date])
}

// Производственный календарь. Рабочие/выходные дни недели задаёт график
// сотрудника (work_schedules) — календарь хранит только общефирменные
// исключения поверх любого графика. Дни без строки работают по графику.
model production_calendar {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique @db.Date
  // holiday — праздник | weekend — разовый выходной | short — сокращённый день
  day_type      String   @db.VarChar(20)
  name          String?  @db.VarChar(255)
  // только для day_type = short: на сколько минут сокращён день
  short_minutes Int?
  added_by      Int
  added_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  addedBy users @relation(fields: [added_by], references: [id])

  @@index([date])
}

model positions {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(255)
  status     Boolean  @default(true)
  sort_order Int      @default(0)
  added_at   DateTime @default(now()) @db.Timestamptz(6)

  employmentOrders  employment_orders[]
  employees         employees[]
  staffingPositions staffing_position[]
  tasksAssigned     tasks[]             @relation("TaskAssigneePosition")
}

model sessions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refresh_token String
  ip_address    String?
  user_agent    String?
  added_at      DateTime  @default(now()) @db.Timestamptz(6)
  expires_at    DateTime? @db.Timestamptz(6)
  user_id       Int
  user          users     @relation(fields: [user_id], references: [id])
}

model telegram_bots {
  id                        Int      @id @default(autoincrement())
  name                      String?  @unique @db.VarChar(255)
  chat_id                   String?  @unique @db.VarChar(255)
  selectedEmployeeIds       Int[]
  receive_late_report       Boolean?
  receive_event_alerts      Boolean?
  receive_attendance_report Boolean?
  status                    Boolean? @default(true)
  added_at                  DateTime @default(now()) @db.Timestamptz(6)
}

model time_off {
  id              Int      @id @default(autoincrement())
  employee_id     Int
  reason          String
  date_from       DateTime @db.Timestamptz(6)
  date_to         DateTime @db.Timestamptz(6)
  added_by        Int
  added_at        DateTime @default(now()) @db.Timestamptz(6)
  is_company_paid Boolean  @default(false)
  type            String   @default("hour") @db.VarChar(10)
  credited_hours  Int?     @default(0)

  addedBy  users     @relation(fields: [added_by], references: [id])
  employee employees @relation("employeeTimeOffs", fields: [employee_id], references: [id])

  @@index([employee_id, date_from, date_to])
}

model timesheet {
  id           Int      @id @default(autoincrement())
  month        Int
  year         Int
  day          Int?
  worked_hours String?  @db.VarChar
  intervals    String[]
  user_id      Int
}

model users {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  password          String
  telegram_id       String?  @unique @db.VarChar(60)
  employee_id       Int?
  status            Boolean  @default(true)
  access_level      String?
  branch_access     Int[]
  department_access Int[]
  language          String   @default("ru")
  theme             String   @default("light")
  sidebar           String   @default("opened")
  view_mode         String   @default("branch")
  personal_menus    String[] @default([])
  active_branch_id  Int?
  ignore_gps_check  Boolean  @default(false)
  settings          Json?
  // Меню «Производство»: типы операций, доступные логину (пусто — все), право
  // редактировать шаблон стикера и «только свои» — в истории приёма показывать лишь
  // то, что принял сам логин. Задаёт администратор в карточке логина; в settings
  // не кладём — пользователь правит его сам через профиль.
  production_operation_ids Int[]   @default([])
  can_edit_sticker         Boolean @default(true)
  production_own_only      Boolean @default(false)
  // Телеграм-приложение: можно ли отмечать «Начать работу» / «Завершить работу»
  // кнопкой на главной странице. Задаёт администратор в карточке логина.
  telegram_work_punch      Boolean @default(false)
  added_at          DateTime @default(now()) @db.Timestamptz(6)

  employee                   employees?                      @relation(fields: [employee_id], references: [id])
  menuAccess                 user_menu_access[]
  telegramMenuAccess         user_telegram_menu_access[]
  sessions                  sessions[]
  productionCalendar         production_calendar[]
  branches                   branches[]
  timeOff                    time_off[]
  employeeScheduleHistory    employee_schedule_history[]
  employeeSalaryHistory      employee_salary_history[]
  payrollSheetsAdded         payroll_sheets[]                @relation("PayrollAddedBy")
  payrollSheetsApproved      payroll_sheets[]                @relation("PayrollApprovedBy")
  auditLogs                  audit_logs[]
  employeeDebtsAdded         employee_debts[]                @relation("EmployeeDebtAddedBy")
  tasksCreated               tasks[]                         @relation("TaskCreatedBy")
  tasksConfirmed             tasks[]                         @relation("TaskConfirmedBy")
  tasksAssignedUser          tasks[]                         @relation("TaskAssigneeUser")
  taskComments               task_comments[]
  taskFiles                  task_files[]
  attendanceFilterPresets    attendance_filter_presets[]     @relation("AttendanceFilterPresetCreatedBy")
  timesheetFilterPresets     timesheet_filter_presets[]      @relation("TimesheetFilterPresetCreatedBy")
  lateEmployeesFilterPresets late_employees_filter_presets[] @relation("LateEmployeesFilterPresetCreatedBy")
  cronTasks                  cron_tasks[]                    @relation("CronTaskCreatedBy")
  assetAssignments           asset_assignments[]
  canteenAllowances          canteen_allowances[]            @relation("CanteenAllowanceCreatedBy")
  batchReceipts              batch_receipts[]
  batchReceiptItemsAdded     batch_receipt_items[]
  operations                 operations[]
  workStickersAdded          work_stickers[]                 @relation("WorkStickerAddedBy")
  workStickersScanned        work_stickers[]                 @relation("WorkStickerScannedBy")
  operationTypesAdded        operation_types[]               @relation("OperationTypeAddedBy")
  employeeTeamsAdded         employee_teams[]                @relation("EmployeeTeamAddedBy")
  stockPickingsAdded         stock_pickings[]                @relation("PickingAddedBy")
  stockPickingsConfirmed     stock_pickings[]                @relation("PickingConfirmedBy")
  stockPickingsDone          stock_pickings[]                @relation("PickingDoneBy")
  stockPickingsEdited        stock_pickings[]                @relation("PickingEditedBy")

  @@unique([employee_id], map: "unique_employee_per_user")
  @@index([employee_id])
  @@index([telegram_id])
}

model menus {
  id         Int     @id @default(autoincrement())
  name       String  @unique @db.VarChar(100)
  path       String? @db.VarChar(255)
  parent_id  Int?
  parent     menus?  @relation("MenuHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children   menus[] @relation("MenuHierarchy")
  sort_order Int     @default(0)

  access         user_menu_access[]
  telegramAccess user_telegram_menu_access[]
}

model user_menu_access {
  id         Int     @id @default(autoincrement())
  user_id    Int
  menu_id    Int
  can_view   Boolean @default(false)
  can_add    Boolean @default(false)
  can_update Boolean @default(false)
  can_delete Boolean @default(false)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  menu menus @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@unique([user_id, menu_id])
}

// Отдельные права логина на меню в телеграм приложении. Нет строк — телеграм
// использует те же права, что и веб (user_menu_access).
model user_telegram_menu_access {
  id         Int     @id @default(autoincrement())
  user_id    Int
  menu_id    Int
  can_view   Boolean @default(false)
  can_add    Boolean @default(false)
  can_update Boolean @default(false)
  can_delete Boolean @default(false)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  menu menus @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@unique([user_id, menu_id])
}

model work_schedules {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  type         String?  @db.VarChar // fixed | shift | flexible
  weekly_days  Int? // только для fixed
  weekly_hours Int?
  work_days    Json? // массив объектов для fixed
  shifts       Json? // массив объектов для shift
  added_at     DateTime @default(now()) @db.Timestamptz(6)
  status       Boolean? @default(true)

  // Допустимые окна опоздания/ухода (минуты)
  late_tolerance_minutes        Int? @default(0)
  early_leave_tolerance_minutes Int? @default(0)
  late_leave_tolerance_minutes  Int? @default(0)

  // Метод расчёта отработанного времени для fixed/remote
  // by_period  — сумма всех пар вход/выход
  // first_last — от первого входа до последнего выхода
  time_calc_method String? @default("by_period") @db.VarChar

  employees               employees[]
  employeeScheduleHistory employee_schedule_history[]
}

model employee_schedule_history {
  id               Int       @id @default(autoincrement())
  employee_id      Int
  work_schedule_id Int
  date_from        DateTime  @db.Date
  date_to          DateTime? @db.Date
  added_at         DateTime  @default(now())
  added_by         Int

  // relations
  employee     employees      @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  workSchedule work_schedules @relation(fields: [work_schedule_id], references: [id])
  addedBy      users          @relation(fields: [added_by], references: [id])

  @@index([employee_id, date_from])
  @@index([employee_id, date_to])
}

model employee_salary_history {
  id          Int       @id @default(autoincrement())
  employee_id Int
  salary_type String    @db.VarChar(20) // monthly | hourly | piecework
  amount      Decimal   @db.Decimal(15, 2)
  date_from   DateTime  @db.Date
  date_to     DateTime? @db.Date
  note        String?
  added_at    DateTime  @default(now()) @db.Timestamptz(6)
  added_by    Int

  employee employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  addedBy  users     @relation(fields: [added_by], references: [id])

  @@index([employee_id, date_from])
}

// Имущество компании, закреплённое за сотрудником во временное пользование
// (Odoo: equipment assignment, SAP: asset custody). Одна строка = одна позиция,
// переданная сотруднику, с историей возврата/списания.
model asset_assignments {
  id                   Int       @id @default(autoincrement())
  employee_id          Int
  asset_name           String    @db.VarChar(255) // Компьютер
  asset_spec           String? // i3 8/256gb
  asset_condition      String?   @db.VarChar(100) // Отличное
  quantity             Int       @default(1)
  inventory_number     String?   @db.VarChar(100) // инвентарный номер
  assigned_date        DateTime  @db.Date
  expected_return_date DateTime? @db.Date
  // assigned — на руках | returned — возвращено | scrapped — списано
  state                String    @default("assigned") @db.VarChar(20)
  return_date          DateTime? @db.Date
  return_condition     String?   @db.VarChar(100)
  note                 String?
  // произвольные доп. поля: [{ "label": "Гарантия", "value": "до 2027" }]
  custom_fields        Json?
  added_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  added_by             Int

  employee employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  addedBy  users     @relation(fields: [added_by], references: [id])

  @@index([employee_id, assigned_date])
  @@index([state])
}

model doors {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  status    Boolean  @default(true)
  branch_id Int?
  latitude  Float?
  longitude Float?
  added_at  DateTime @default(now()) @db.Timestamptz(6)

  branch      branches?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  employees   employees[]
  faceDevices face_devices[]
  facePasses  face_passes[]
}

model face_devices {
  id            Int      @id @default(autoincrement())
  name          String?  @db.VarChar(100)
  door_id       Int
  device_ip     String   @unique @db.VarChar(50)
  // MAC — единственный ключ, по которому webhook находит устройство.
  // IP плавает (DHCP/NAT), имя не уникально, серийника в событии нет.
  mac_address   String?  @unique @db.VarChar(17)
  // serial_number — не для поиска: это X-Devserial для облачного API
  // удалённых устройств (RemoteFaceDeviceClient).
  serial_number String?  @db.VarChar(50)
  port          Int?     @default(80)
  direction     String?  @db.VarChar(10)
  password      String?  @db.VarChar(100)
  status        Boolean? @default(true)
  is_local      Boolean  @default(false)
  // purpose = "access"  → обычный проход, событие пишется в face_passes
  // purpose = "canteen" → терминал столовой: событие списывает порцию
  //                       и пишется в canteen_meals, проход не создаётся
  purpose       String   @default("access") @db.VarChar(20)
  added_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  door         doors           @relation(fields: [door_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  facePasses   face_passes[]
  canteenMeals canteen_meals[]
}

model gates {
  id                Int      @id @default(autoincrement())
  name              String?  @db.VarChar(100)
  branch_id         Int?
  telegram_chat_ids String[] @default([]) @db.VarChar(20)
  status            Boolean? @default(true)

  added_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  branch        branches?        @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  cameras       anpr_cameras[]
  vehiclePasses vehicle_passes[]
}

model anpr_cameras {
  id          Int     @id @default(autoincrement())
  name        String? @db.VarChar(100)
  gate_id     Int
  camera_ip   String  @unique @db.VarChar(50)
  mac_address String? @unique @db.VarChar(17)
  port        Int?    @default(80)
  direction   String? @db.VarChar(10)
  username    String? @db.VarChar(50)
  password    String? @db.VarChar(100)

  status Boolean? @default(true)

  added_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  gate gates @relation(fields: [gate_id], references: [id], onDelete: Cascade)

  vehiclePasses vehicle_passes[]
}

model vehicle_passes {
  id           Int     @id @default(autoincrement())
  branch_id    Int?
  gate_id      Int
  camera_id    Int?
  plate_number String  @db.VarChar(20)
  direction    String? @db.VarChar(10)
  photo        String?

  date       DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  branch branches?     @relation(fields: [branch_id], references: [id])
  gate   gates         @relation(fields: [gate_id], references: [id])
  camera anpr_cameras? @relation(fields: [camera_id], references: [id])
}

model payroll_sheets {
  id          Int       @id @default(autoincrement())
  month       Int
  year        Int
  status      String    @default("draft") @db.VarChar(20)
  added_by    Int
  added_at    DateTime  @default(now()) @db.Timestamptz(6)
  approved_by Int?
  approved_at DateTime? @db.Timestamptz(6)

  items      payroll_sheet_items[]
  addedBy    users                 @relation("PayrollAddedBy", fields: [added_by], references: [id])
  approvedBy users?                @relation("PayrollApprovedBy", fields: [approved_by], references: [id])

  @@unique([month, year])
}

model payroll_sheet_items {
  id                 Int     @id @default(autoincrement())
  sheet_id           Int
  employee_id        Int
  base_salary        Decimal @db.Decimal(15, 2)
  salary_type        String  @db.VarChar(20)
  worked_days        Int     @default(0)
  total_work_days    Int     @default(0)
  worked_hours       String? @db.VarChar(10)
  total_work_hours   String? @db.VarChar(10)
  accrued            Decimal @db.Decimal(15, 2)
  debt_balance       Decimal @default(0) @db.Decimal(15, 2)
  debt_deduction     Decimal @default(0) @db.Decimal(15, 2)
  debt_mode          String  @default("skip") @db.VarChar(20)
  debt_comment       String?
  manual_adjustment  Decimal @default(0) @db.Decimal(15, 2)
  adjustment_comment String?
  late_minutes       Int     @default(0)
  overtime_minutes   Int     @default(0)
  apply_late         Boolean @default(false)
  apply_overtime     Boolean @default(false)
  late_amount        Decimal @default(0) @db.Decimal(15, 2)
  overtime_amount    Decimal @default(0) @db.Decimal(15, 2)
  net                Decimal @db.Decimal(15, 2)
  salary_balance     Decimal @default(0) @db.Decimal(15, 2)
  paid_amount        Decimal @default(0) @db.Decimal(15, 2)
  status             String  @default("draft") @db.VarChar(20)
  payout_status      String  @default("unpaid") @db.VarChar(20)

  sheet       payroll_sheets         @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  employee    employees              @relation(fields: [employee_id], references: [id])
  paymentLogs payroll_payment_logs[]

  @@unique([sheet_id, employee_id])
  @@index([sheet_id])
}

model employee_debts {
  id          Int      @id @default(autoincrement())
  employee_id Int
  amount      Decimal  @db.Decimal(15, 2)
  issued_at   DateTime @db.Date
  note        String?
  added_by    Int
  added_at    DateTime @default(now()) @db.Timestamptz(6)

  employee employees @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  addedBy  users     @relation("EmployeeDebtAddedBy", fields: [added_by], references: [id])

  @@index([employee_id])
  @@index([issued_at])
}

model payroll_payment_logs {
  id           Int      @id @default(autoincrement())
  item_id      Int
  amount       Decimal  @db.Decimal(15, 2)
  payment_date DateTime @db.Date
  note         String?
  is_advance   Boolean  @default(false)
  added_at     DateTime @default(now()) @db.Timestamptz(6)

