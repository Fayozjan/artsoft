  task_id    Int
  user_id    Int
  text       String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)

  task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id])

  @@index([task_id])
}

model task_files {
