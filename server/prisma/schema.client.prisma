model tasks {
  id                     Int       @id @default(autoincrement())
  title                  String    @db.VarChar(255)
  description            String?   @db.Text
  priority               String    @default("medium") @db.VarChar(20)
  status                 String    @default("draft") @db.VarChar(20)
  deadline               DateTime? @db.Timestamptz(6)
  assignee_employee_id   Int?
  assignee_department_id Int?
  assignee_position_id   Int?
  assignee_user_id       Int?
  created_by_id          Int
  confirmed_by_id        Int?
  published_at           DateTime? @db.Timestamptz(6)
  accepted_at            DateTime? @db.Timestamptz(6)
  completed_at           DateTime? @db.Timestamptz(6)
  confirmed_at           DateTime? @db.Timestamptz(6)
  cancelled_at           DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  assignee_employee   employees?      @relation("TaskAssigneeEmployee", fields: [assignee_employee_id], references: [id])
  assignee_department departments?    @relation("TaskAssigneeDepartment", fields: [assignee_department_id], references: [id])
  assignee_position   positions?      @relation("TaskAssigneePosition", fields: [assignee_position_id], references: [id])
  assignee_user       users?          @relation("TaskAssigneeUser", fields: [assignee_user_id], references: [id])
  created_by          users           @relation("TaskCreatedBy", fields: [created_by_id], references: [id])
  confirmed_by        users?          @relation("TaskConfirmedBy", fields: [confirmed_by_id], references: [id])
  comments            task_comments[]
  files               task_files[]

  @@index([status])
  @@index([assignee_employee_id])
  @@index([assignee_department_id])
  @@index([created_by_id])
  @@index([deadline])
}

model task_comments {
